{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "akive/figurate",
    "type": "project",
    "description": "The figurate system for conversations.",
    "keywords": [],
    "require": {
        "php": "^8.2",
        "api-platform/laravel": "^4.2",
        "laravel/ai": "^0.10.1",
        "laravel/framework": "^12.0",
        "laravel/mcp": "^0.9.1",
        "laravel/passport": "^13.4",
        "laravel/reverb": "^1.7",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "nuwave/lighthouse": "^6.69",
        "phpdocumentor/type-resolver": "^1.7",
        "phrity/websocket": "^3.6",
        "predis/predis": "^3.4",
        "pusher/pusher-php-server": "^7.2",
        "sajya/client": "^1.4",
        "sajya/server": "^7.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-fractal": "^6.4",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-passkeys": "^1.6",
        "spatie/laravel-permission": "^7.2",
        "spatie/laravel-webhook-client": "^3.5",
        "spatie/laravel-webhook-server": "^3.10",
        "staudenmeir/eloquent-has-many-deep": "^1.7",
        "staudenmeir/eloquent-json-relations": "^1.1",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33",
        "wikimedia/composer-merge-plugin": "dev-master"
    },
    "require-dev": {
        "behat/behat": "4.0.0-alpha1",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test:root": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:plugins": [
            "@php -r \"\\$pluginTestDirectories = array_merge(glob('mod/*/tests', GLOB_ONLYDIR) ?: [], glob('ext/*/tests', GLOB_ONLYDIR) ?: []); if (\\$pluginTestDirectories === []) { fwrite(STDOUT, 'No plugin tests found.'.PHP_EOL); exit(0); } foreach (\\$pluginTestDirectories as \\$pluginTestDirectory) { fwrite(STDOUT, PHP_EOL.'==> '.\\$pluginTestDirectory.PHP_EOL); passthru('php artisan test --compact '.escapeshellarg(\\$pluginTestDirectory), \\$exitCode); if (\\$exitCode !== 0) { exit(\\$exitCode); } }\""
        ],
        "test:behaviour": [
            "@php vendor/bin/behat --strict"
        ],
        "test": [
            "@test:root",
            "@test:behaviour",
            "@test:plugins"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [],
            "require": [
                "composer.local.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": true,
            "merge-replace": true,
            "merge-scripts": true
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
